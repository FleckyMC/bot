# Copy this file to .env and edit the values. Never commit your real .env file.

# Founder login (full control, invisible to admins). Use a long, unique password!
# An existing account with this name is promoted to Founder.
FOUNDER_USER=founder
FOUNDER_PASSWORD=change-me-to-a-long-password

# Optional extra admin accounts, comma separated: name:password,name2:password2
# Admins can also be created/deleted by the Founder in the dashboard.
ADMIN_ACCOUNTS=

# Web server (behind Caddy use HOST=127.0.0.1)
PORT=3000
HOST=127.0.0.1

# Minecraft protocol version; use auto to detect
MC_VERSION=auto

# Set to true when served through HTTPS (e.g. Caddy)
COOKIE_SECURE=true
