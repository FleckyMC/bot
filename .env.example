# Copy this file to .env and edit the values.
# Never commit your real .env file.

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Web server
PORT=3000
HOST=0.0.0.0

# Minecraft protocol version; use auto to detect
MC_VERSION=auto

# Set true only when served through correctly configured HTTPS
COOKIE_SECURE=false
