# Meltrovia dashboard .env  (never commit this file)

# Founder: full control, invisible to admins. An existing account with this name becomes Founder.
FOUNDER_USER=admin
FOUNDER_PASSWORD=rDuFh8V1vf_K8FZoV1muNAYB

# Extra admins (optional), comma separated: name:password,name2:password2
ADMIN_ACCOUNTS=

# Web server (behind Caddy keep HOST=127.0.0.1)
PORT=3000
HOST=127.0.0.1

# Minecraft protocol version; auto detects it
MC_VERSION=auto

# true because the site runs over HTTPS (Caddy)
COOKIE_SECURE=true
